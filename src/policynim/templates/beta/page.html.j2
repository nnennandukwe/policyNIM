{% from "beta/partials/icons.html.j2" import artwork, icon, window_controls, wordmark -%}
{% set source_url = "https://github.com/nnennandukwe/policyNIM" -%}
{% set docs_url = source_url ~ "/blob/main/docs/index.md" -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <link rel="icon" type="image/png" href="{{ favicon_url }}">
    <title>{{ document_title }}</title>
    <script src="{{ beta_theme_init_js_url }}"></script>
    <link rel="stylesheet" href="{{ beta_css_url }}">
  </head>
  <body class="beta-page {{ page_class }}">
    {{ artwork() }}
    <a class="skip-link" href="#setup-window">Skip to setup</a>
    <div class="desktop">
      <nav class="shortcuts" aria-label="Desktop shortcuts">
        <a href="{{ portal_url }}">{{ icon("setup") }}Setup</a>
        <a href="{{ docs_url }}">{{ icon("docs") }}Docs</a>
        <a href="{{ source_url }}">{{ icon("source") }}Source</a>
      </nav>
      <main class="setup-window" id="setup-window" tabindex="-1">
        <div class="titlebar">
          {{ icon("shield") }} <span>PolicyNIM Setup</span>
          {{ window_controls() }}
        </div>
        <div class="menu-strip">
          <span aria-hidden="true" class="menu-labels"><span>File</span><span>View</span><span>Help</span></span>
          {% include "beta/partials/theme_toggle.html.j2" %}
        </div>
        {% for notice in notices if not (new_key and notice.tone == "success") %}
          {% include "beta/partials/notice.html.j2" %}
        {% endfor %}
        {% block content %}{% endblock %}
        <div class="window-status">{% block window_status %}GitHub sign-in required{% endblock %}</div>
      </main>
    </div>
    <div class="taskbar" aria-hidden="true">
      <span class="start-label">{{ icon("start") }}Start</span>
      <span class="task-label">{{ icon("shield") }}PolicyNIM</span>
      <span class="taskbar-status">Hosted beta</span>
    </div>
    <script src="{{ beta_page_js_url }}"></script>
  </body>
</html>
