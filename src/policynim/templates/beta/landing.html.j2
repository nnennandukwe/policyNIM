{% extends "beta/page.html.j2" %}

{% block content %}
<div class="welcome">
  <section class="welcome-intro">
    <p class="eyebrow">Hosted beta</p>
    <h1 class="wordmark">{{ wordmark() }}</h1>
    <h2>Check policy before you code.</h2>
    <p class="welcome-description">Give Codex and Claude Code policy guidance with source citations.</p>
    <a class="beta-button sign-in" href="{{ github_start_path }}">
      <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 0C3.58 0 0 3.64 0 8.13c0 3.59 2.29 6.63 5.47 7.7.4.07.55-.18.55-.4v-1.53c-2.23.49-2.7-.96-2.7-.96-.36-.94-.9-1.19-.9-1.19-.73-.5.06-.49.06-.49.81.06 1.23.83 1.23.83.72 1.25 1.88.89 2.34.68.07-.53.28-.89.51-1.09-1.78-.2-3.64-.9-3.64-4.02 0-.89.31-1.61.82-2.18-.08-.21-.36-1.03.08-2.15 0 0 .67-.22 2.2.83a7.52 7.52 0 0 1 4 0c1.53-1.05 2.2-.83 2.2-.83.44 1.12.16 1.94.08 2.15.51.57.82 1.29.82 2.18 0 3.13-1.87 3.82-3.65 4.02.29.25.54.75.54 1.51v2.24c0 .22.15.48.55.4A8.11 8.11 0 0 0 16 8.13C16 3.64 12.42 0 8 0Z"/>
      </svg>
      Sign in with GitHub
    </a>
    <div class="welcome-links">
      <a href="{{ docs_url }}">Read the docs</a>
      <details>
        <summary>Setup details</summary>
        <div class="setup-details">
          <p>The hosted service uses a maintained public policy profile. For your own policies and storage, <a href="{{ source_url }}/blob/main/docs/local-onboarding.md">set up PolicyNIM locally</a> with <code>policynim setup</code>.</p>
          <dl>
            <dt>Hosted MCP endpoint</dt><dd><code>{{ mcp_url }}</code></dd>
            <dt>Portal URL</dt><dd><a href="{{ portal_url }}">{{ portal_url }}</a></dd>
          </dl>
        </div>
      </details>
    </div>
  </section>
  <section class="welcome-terminal" aria-labelledby="setup-heading">
    <div class="titlebar terminal-title" aria-hidden="true">welcome.txt {{ window_controls() }}</div>
    <div class="terminal-screen">
      {{ icon("shield") }}
      <h2 id="setup-heading">Your setup</h2>
      <ol>
        <li>Sign in with GitHub</li>
        <li>Create an API key</li>
        <li>Connect your agent</li>
      </ol>
      <span class="terminal-cursor" aria-hidden="true"></span>
    </div>
  </section>
</div>
{% endblock %}

{% block window_status %}{% if notices %}See the portal notice above{% else %}GitHub sign-in required{% endif %}{% endblock %}
