{
  "realm": "policynim",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "false"},
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "policies:read",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [
        {
          "name": "policynim-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${POLICYNIM_OAUTH_RESOURCE}",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "policies:evaluate",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [
        {
          "name": "policynim-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${POLICYNIM_OAUTH_RESOURCE}",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "${POLICYNIM_OAUTH_RESOURCE}",
      "secret": "${POLICYNIM_INTROSPECTION_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {"resource_url": "${POLICYNIM_OAUTH_RESOURCE}"}
    },
    {
      "clientId": "${POLICYNIM_CHATGPT_CLIENT_ID}",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${POLICYNIM_CHATGPT_REDIRECT_URI}"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["policies:read", "policies:evaluate"]
    }
  ]
}
