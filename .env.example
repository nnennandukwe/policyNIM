# Backward-compatible local-development example.
# Prefer copying .env.development.example for local work and
# .env.production.example when preparing hosted Railway variables.
NVIDIA_API_KEY=
POLICYNIM_ENV=development
# Optional local/self-hosted composition: set POLICYNIM_PROFILE to a profile TOML path.
# Leave it unset for bundled policies; don't combine it with POLICYNIM_CORPUS_DIR.
# Complete runtime generations; ingest atomically activates a new object here.
POLICYNIM_GENERATIONS_DIR=data/generations
# Standalone inputs retained for explicit generation migration.
POLICYNIM_INDEX_DB_PATH=data/index.sqlite3
POLICYNIM_RUNTIME_RULES_ARTIFACT_PATH=data/runtime/runtime_rules.json
POLICYNIM_RUNTIME_EVIDENCE_DB_PATH=data/runtime/runtime_evidence.sqlite3
POLICYNIM_RUNTIME_SHELL_TIMEOUT_SECONDS=300
POLICYNIM_EVAL_WORKSPACE_DIR=data/evals/workspace
POLICYNIM_DEFAULT_TOP_K=5
POLICYNIM_EMBED_BATCH_SIZE=32
POLICYNIM_NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
POLICYNIM_NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
POLICYNIM_NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
POLICYNIM_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
POLICYNIM_NVIDIA_RETRIEVAL_BASE_URL=https://ai.api.nvidia.com/v1/retrieval
POLICYNIM_NVIDIA_TIMEOUT_SECONDS=30
POLICYNIM_NVIDIA_MAX_RETRIES=2
POLICYNIM_OPERATION_TIMEOUT_SECONDS=120
POLICYNIM_NVIDIA_RETRY_INITIAL_SECONDS=0.5
POLICYNIM_NVIDIA_RETRY_MAX_SECONDS=8
# Bare IPv4, IPv6, or ASCII DNS host; direct HTTP at MCP_PORT is allowed without auth.
# Wildcard binds (0.0.0.0 or ::) need MCP_PUBLIC_BASE_URL for remote access.
POLICYNIM_MCP_HOST=127.0.0.1
POLICYNIM_MCP_PORT=6000
POLICYNIM_MCP_MAX_CONCURRENT_OPERATIONS=10
POLICYNIM_MCP_MAX_CONCURRENT_OPERATIONS_PER_PRINCIPAL=2
POLICYNIM_MCP_PRINCIPAL_DAILY_OPERATION_QUOTA=500
POLICYNIM_MCP_REQUIRE_AUTH=false
POLICYNIM_EVAL_UI_PORT=8001

# Optional HTTP settings (public origin is required when authentication is enabled):
# POLICYNIM_MCP_BEARER_TOKENS=token-a,token-b
# POLICYNIM_MCP_PUBLIC_BASE_URL=https://your-host
# POLICYNIM_BETA_SIGNUP_ENABLED=true
# POLICYNIM_BETA_AUTH_DB_PATH=data/runtime/auth.sqlite3
# POLICYNIM_BETA_SESSION_SECRET=replace-with-a-random-secret
# POLICYNIM_BETA_GITHUB_CLIENT_ID=github-oauth-client-id
# POLICYNIM_BETA_GITHUB_CLIENT_SECRET=github-oauth-client-secret
# Beta keys use this accepted-operation allowance; authentication is free.
# POLICYNIM_BETA_DAILY_REQUEST_QUOTA=500
# POLICYNIM_BETA_AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
# POLICYNIM_BETA_AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Optional external MCP OAuth foundation; see docs/hosted-authorization.md.
# Leave issuer/client settings absent to retain existing bearer-key deployment behavior.
# POLICYNIM_MCP_OAUTH_ISSUER_URL=https://identity.example/realms/policynim
# POLICYNIM_MCP_OAUTH_CLIENT_ID=https://your-host/mcp
# Set POLICYNIM_MCP_OAUTH_CLIENT_SECRET through your secret manager.
# POLICYNIM_MCP_OAUTH_TIMEOUT_SECONDS=5
# POLICYNIM_MCP_OAUTH_MAX_CONCURRENT_REQUESTS=64
# POLICYNIM_MCP_OAUTH_REQUEST_BODY_TIMEOUT_SECONDS=30
# POLICYNIM_MCP_OAUTH_ALLOW_LEGACY_KEYS=false
