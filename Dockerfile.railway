ARG PYTHON_BASE_IMAGE=python:3.11.15-slim-trixie@sha256:9358444059ed78e2975ada2c189f1c1a3144a5dab6f35bff8c981afb38946634
ARG POLICYNIM_NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
ARG POLICYNIM_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ARG POLICYNIM_EMBED_BATCH_SIZE=32
ARG POLICYNIM_NVIDIA_TIMEOUT_SECONDS=30.0
ARG POLICYNIM_NVIDIA_MAX_RETRIES=2

FROM ${PYTHON_BASE_IMAGE} AS builder

ARG POLICYNIM_NVIDIA_EMBED_MODEL
ARG POLICYNIM_NVIDIA_BASE_URL
ARG POLICYNIM_EMBED_BATCH_SIZE
ARG POLICYNIM_NVIDIA_TIMEOUT_SECONDS
ARG POLICYNIM_NVIDIA_MAX_RETRIES

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POLICYNIM_NVIDIA_EMBED_MODEL=${POLICYNIM_NVIDIA_EMBED_MODEL} \
    POLICYNIM_NVIDIA_BASE_URL=${POLICYNIM_NVIDIA_BASE_URL} \
    POLICYNIM_EMBED_BATCH_SIZE=${POLICYNIM_EMBED_BATCH_SIZE} \
    POLICYNIM_NVIDIA_TIMEOUT_SECONDS=${POLICYNIM_NVIDIA_TIMEOUT_SECONDS} \
    POLICYNIM_NVIDIA_MAX_RETRIES=${POLICYNIM_NVIDIA_MAX_RETRIES} \
    POLICYNIM_RUNTIME_RULES_ARTIFACT_PATH=/app/data/runtime/runtime_rules.json \
    POLICYNIM_INDEX_DB_PATH=/app/data/index.sqlite3

WORKDIR /app

RUN pip install --no-cache-dir uv==0.7.12

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY policies ./policies
COPY evals ./evals

# Railway's Dockerfile builder rejects non-cache mounts, so its deploy-specific
# Dockerfile still has to source the bake-time key from a build arg.
ARG NVIDIA_API_KEY

RUN uv sync --frozen
# ARG values are already in the build process environment. Do not expand the
# credential into a RUN instruction, which Railway displays in build logs.
RUN uv run --no-sync policynim ingest


FROM ${PYTHON_BASE_IMAGE} AS runtime

ARG POLICYNIM_NVIDIA_EMBED_MODEL
ARG POLICYNIM_NVIDIA_BASE_URL
ARG POLICYNIM_EMBED_BATCH_SIZE
ARG POLICYNIM_NVIDIA_TIMEOUT_SECONDS
ARG POLICYNIM_NVIDIA_MAX_RETRIES

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POLICYNIM_NVIDIA_EMBED_MODEL=${POLICYNIM_NVIDIA_EMBED_MODEL} \
    POLICYNIM_NVIDIA_BASE_URL=${POLICYNIM_NVIDIA_BASE_URL} \
    POLICYNIM_EMBED_BATCH_SIZE=${POLICYNIM_EMBED_BATCH_SIZE} \
    POLICYNIM_NVIDIA_TIMEOUT_SECONDS=${POLICYNIM_NVIDIA_TIMEOUT_SECONDS} \
    POLICYNIM_NVIDIA_MAX_RETRIES=${POLICYNIM_NVIDIA_MAX_RETRIES} \
    POLICYNIM_RUNTIME_RULES_ARTIFACT_PATH=/app/data/runtime/runtime_rules.json \
    POLICYNIM_INDEX_DB_PATH=/app/data/index.sqlite3 \
    POLICYNIM_MCP_HOST=0.0.0.0 \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY --from=builder /app/policies /app/policies
COPY --from=builder /app/evals /app/evals
COPY --from=builder /app/pyproject.toml /app/pyproject.toml
COPY --from=builder /app/README.md /app/README.md
COPY --from=builder /app/LICENSE /app/LICENSE
COPY --from=builder /app/data/index.sqlite3 /app/data/index.sqlite3
COPY --from=builder /app/data/runtime/runtime_rules.json /app/data/runtime/runtime_rules.json

CMD ["policynim", "mcp", "--transport", "streamable-http"]
